# ── Arc Network ───────────────────────────────────────────────────────────────
ARC_TESTNET_URL=https://testnet.arc.xyz
ARC_MAINNET_URL=https://mainnet.arc.xyz

# ── Wallet ────────────────────────────────────────────────────────────────────
# Create fresh wallet in MetaMask → Account Details → Export Private Key
# Fund via Arc testnet faucet
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# ── Arc Block Explorer ────────────────────────────────────────────────────────
ARCSCAN_API_KEY=

# ── USDC on Arc ───────────────────────────────────────────────────────────────
USDC_TOKEN=

# ── Deployed Contract Addresses (fill after deploy) ───────────────────────────
GROTH16_VERIFIER_ADDRESS=
COGNITION_VERIFIER_ADDRESS=
AGENT_REGISTRY_ADDRESS=
INSURANCE_POOL_ADDRESS=
AGENT_GUARDIAN_ADDRESS=
GUARDIAN_CONTRACT=
REGISTRY_CONTRACT=

# ── Azure OpenAI ($100 student credits) ───────────────────────────────────────
# portal.azure.com → Azure OpenAI → Keys and Endpoint
# Deploy: gpt-4o  AND  text-embedding-ada-002
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_DEPLOYMENT_NAME=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ── Groq (3 keys for 3 Council agents — different models per key) ─────────────
# console.groq.com → API Keys → Create key
# Key 1 → Risk Agent     (Llama 3.3 70B)
# Key 2 → Compliance     (Mixtral 8x7B)
# Key 3 → Execution      (Llama 3.1 8B)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# ── Gemini (2 keys — synthesizer + anomaly monitor) ───────────────────────────
# aistudio.google.com → Get API Key
# Key 1 → Consensus Synthesizer  (Gemini 1.5 Pro)
# Key 2 → Anomaly Monitor        (Gemini 2.0 Flash)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# ── Qdrant Cloud (free tier vector store — RAG memory) ────────────────────────
# cloud.qdrant.io → Create Cluster → Free tier
# Copy URL and API key from dashboard
QDRANT_URL=https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=

# ── Supabase (free tier PostgreSQL — feedback logs) ───────────────────────────
# app.supabase.com → New Project → Settings → API
# Run these SQL commands in Supabase SQL Editor to create tables:
#
# CREATE TABLE council_sessions (
#   id            SERIAL PRIMARY KEY,
#   session_id    TEXT NOT NULL,
#   agent         TEXT NOT NULL,
#   recipient     TEXT NOT NULL,
#   amount        TEXT NOT NULL,
#   reason        TEXT,
#   approved      BOOLEAN,
#   outcome       TEXT,
#   consensus     TEXT,
#   total_cost    NUMERIC,
#   created_at    TIMESTAMPTZ DEFAULT NOW()
# );
#
# CREATE TABLE council_votes (
#   id            SERIAL PRIMARY KEY,
#   session_id    TEXT NOT NULL,
#   agent_role    TEXT NOT NULL,
#   model         TEXT NOT NULL,
#   decision      TEXT NOT NULL,
#   confidence    INTEGER,
#   reasoning     TEXT,
#   flags         TEXT,
#   latency_ms    INTEGER,
#   cost_usdc     NUMERIC,
#   created_at    TIMESTAMPTZ DEFAULT NOW()
# );
#
# CREATE INDEX ON council_sessions (agent);
# CREATE INDEX ON council_votes (session_id);
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=

# ── Circle Configuration ──────────────────────────────────────────────────────
# console.circle.com (sign up with hackathon email)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_APP_ID=
CIRCLE_ENVIRONMENT=sandbox
