{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["scripts/**/*", "test/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
